prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: wispc
Description: Client SDK for the wisp display-server protocol (dynamically-linked, static-links wisp_protocol internally)
Version: @WISPC_VERSION@
Libs: -L${libdir} -lwispc
Cflags: -I${includedir}
