CompileFlags:
  # compile_commands.json is generated by CMake into build/ (a regenerated,
  # gitignored directory) rather than committed at this level. clangd would
  # normally auto-discover it by walking up from each source file's directory
  # and checking a build/ subdir at each level, but pointing at it explicitly
  # avoids ambiguity if multiple build-* dirs exist side by side (e.g.
  # build-tsan/ from a sanitizer configure).
  CompilationDatabase: build
